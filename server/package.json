{
  "name": "@collab/server",
  "version": "0.0.1",
  "private": true,
  "description": "Open collaboration backend for the Obsidian collaboration plugin: a self-hosted y-sweet CRDT server plus a lightweight token-issuing / control-plane service.",
  "type": "module",
  "scripts": {
    "ysweet": "y-sweet serve --host 127.0.0.1 --port 8080 ./.ysweet-data",
    "issuer": "tsx src/index.ts",
    "smoke": "tsx test/smoke-client.ts",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@y-sweet/sdk": "^0.8.0",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "@y-sweet/client": "^0.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "ws": "^8.18.0",
    "y-sweet": "^0.8.0",
    "yjs": "^13.6.0"
  }
}
