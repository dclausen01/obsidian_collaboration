# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# 1. Generate the y-sweet auth pair (appends the two lines below):
#      ./scripts/gen-auth.mjs >> .env
#    Y_SWEET_AUTH          = private key passed to the y-sweet server
#    Y_SWEET_SERVER_TOKEN  = matching token the issuer uses to mint client tokens
Y_SWEET_AUTH=
Y_SWEET_SERVER_TOKEN=

# 2. Public URL embedded in client tokens. Behind the Plesk proxy this is the
#    external endpoint clients connect to over WebSocket, e.g.:
#      Y_SWEET_URL_PREFIX=wss://collab.school.tld
#    Leave empty for local-only testing.
Y_SWEET_URL_PREFIX=

# 3. Optional tuning.
# How long minted tokens are valid (seconds). Default 3600.
TOKEN_TTL_SECONDS=3600
# Host-side ports the containers bind to (loopback only). The Plesk proxy points
# the subdomain at ISSUER_HOST_PORT for /token + /health, and at YSWEET_HOST_PORT
# for the WebSocket endpoint. See docs/deploy-plesk.md.
ISSUER_HOST_PORT=3000
YSWEET_HOST_PORT=8080
